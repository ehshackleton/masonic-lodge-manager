RAILS_ENV=development
DATABASE_URL=postgresql://postgres:postgres@db:5432/masonic_lodge_manager_development
POSTGRES_DB=masonic_lodge_manager_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Copiar el contenido de config/master.key (no usar replace_me)
RAILS_MASTER_KEY=replace_me
# Generar con: docker compose run --rm --no-deps web bundle exec rails secret
SECRET_KEY_BASE=replace_me
APP_HOST=localhost:3000
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
ACTIVE_STORAGE_SERVICE=local
ADMIN_TEMP_PASSWORD=Logia.Temp.2026!A9

# Google Workspace (buzón institucional amentidiez31@granlogiamixta.cl)
# Crear OAuth client en GCP (tipo Web); redirect debe coincidir exactamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/backoffice/workspace/callback
GOOGLE_INSTITUTIONAL_EMAIL=amentidiez31@granlogiamixta.cl
GOOGLE_GMAIL_QUERY=in:inbox newer_than:30d
# Carpeta Drive opcional (scope drive.file); si vacío, sube a "Mi unidad" de la cuenta OAuth
GOOGLE_DRIVE_FOLDER_ID=

