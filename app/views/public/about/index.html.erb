<% content_for :title, "Sobre nosotros | Amenti Diez N°31" %>

<section class="page-shell mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
  <div class="grid items-start gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:gap-12">
    <div class="page-intro amenti-rise">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-line" aria-hidden="true"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-amber-300/90">Amenti</p>
      </div>

      <h1 class="font-display mt-5 text-[2.65rem] leading-[1.04] text-ink sm:text-6xl">Quiénes somos</h1>

      <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-zinc-400 sm:text-base">
        Somos la Respetable Logia Simbólica Amenti Diez N°31, del Valle de Santiago,
        adscrita a la Gran Logia Mixta de Chile. Nacimos el 4 de agosto de 1960 y seguimos
        labrando nuestra piedra con continuidad y sobriedad.
      </p>

      <dl class="hero-meta mt-7 grid max-w-md grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3">
        <div class="hero-meta-item rounded-xl px-3 py-2.5">
          <dt class="font-display text-base text-amber-200/95 sm:text-lg">4 ago 1960</dt>
          <dd class="mt-0.5 text-[10px] font-medium uppercase tracking-[0.12em] text-zinc-500 sm:tracking-[0.16em]">Fundación</dd>
        </div>
        <div class="hero-meta-item rounded-xl px-3 py-2.5">
          <dt class="font-display text-base text-amber-200/95 sm:text-lg">Desde 1982</dt>
          <dd class="mt-0.5 text-[10px] font-medium uppercase tracking-[0.12em] text-zinc-500 sm:tracking-[0.16em]">Logia N°31 GLMCh</dd>
        </div>
      </dl>

      <% if amenti_master_logo_path %>
        <div class="brand-showcase amenti-panel amenti-panel-gold mt-8 rounded-[1.35rem] p-6 sm:p-8">
          <div class="hero-medallion relative mx-auto flex items-center justify-center">
            <div class="hero-medallion-plate absolute inset-0 rounded-full" aria-hidden="true"></div>
            <div class="hero-medallion-ring absolute inset-0 rounded-full" aria-hidden="true"></div>
            <div class="hero-medallion-glow absolute inset-0 rounded-full" aria-hidden="true"></div>
            <%= image_tag amenti_master_logo_path,
                          alt: "Insignia Amenti",
                          class: "hero-logo-image relative z-10 max-h-52 w-full object-contain sm:max-h-56",
                          loading: "lazy",
                          data: {
                            logo_dark: amenti_master_logo_path,
                            logo_light: amenti_master_light_path || amenti_master_logo_path
                          } %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <% [
        ["/historia", "Historia", "Recorremos los hitos que nos trajeron hasta hoy: 1960, nuestros tránsitos y el N°31.", nil],
        ["/espiritu-amentino", "Espíritu amentino", "La identidad simbólica que nos orienta: equilibrio, memoria y fraternidad.", nil],
        ["/insignia", "Insignia", "Nuestra marca y los criterios con que la usamos en público.", amenti_mark_path],
        ["/masoneria", "Masonería", "Respondemos, con cuidado, las preguntas que suelen hacerse sobre nuestra Orden.", nil],
        ["/actualidad", "Actualidad", "Avisos publicados solo cuando hemos autorizado expresamente hacerlo.", nil],
        ["/contacto", "Contacto", "Canal para consultas públicas, con respeto y claridad.", nil]
      ].each_with_index do |(href, title, copy, icon_path), index| %>
        <a href="<%= href %>" class="link-card amenti-panel group rounded-2xl p-5 sm:p-6 <%= "amenti-rise-delay-#{index + 1}" %> amenti-rise">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-amber-300/90"><%= title %></p>
              <p class="mt-2.5 text-sm leading-relaxed text-zinc-400"><%= copy %></p>
              <span class="link-card-arrow mt-4 inline-flex items-center gap-1 text-xs font-semibold text-amber-300/80 transition group-hover:text-amber-200">
                Explorar <span aria-hidden="true">→</span>
              </span>
            </div>
            <% if icon_path %>
              <span class="feature-icon shrink-0">
                <%= image_tag icon_path, alt: "", class: "h-full w-full object-contain p-2", width: 40, height: 40, loading: "lazy" %>
              </span>
            <% end %>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>
