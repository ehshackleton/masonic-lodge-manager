<% content_for :title, "Sobre nosotros | Amenti Diez N°31" %>

<section class="mx-auto max-w-6xl px-6 py-14">
  <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-amber-300">Amenti</p>
      <h1 class="font-display mt-3 text-5xl text-ink sm:text-6xl">Quiénes somos</h1>
      <p class="mt-5 text-lg leading-relaxed text-zinc-300">
        Somos la Respetable Logia Simbólica Amenti Diez N°31, del Valle de Santiago,
        adscrita a la Gran Logia Mixta de Chile. Nacimos el 4 de agosto de 1960 y seguimos
        labrando nuestra piedra con continuidad y sobriedad.
      </p>
      <% if amenti_master_logo_path %>
        <div class="amenti-panel amenti-panel-gold mt-8 flex items-center justify-center rounded-3xl p-8">
          <%= image_tag amenti_master_logo_path,
                        alt: "Insignia Amenti",
                        class: "max-h-64 w-full object-contain",
                        loading: "lazy",
                        data: {
                          logo_dark: amenti_master_logo_path,
                          logo_light: amenti_master_light_path || amenti_master_logo_path
                        } %>
        </div>
      <% end %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <% [
        ["/historia", "Historia", "Recorremos juntos los hitos que nos trajeron hasta hoy: 1960, nuestros tránsitos y el N°31."],
        ["/espiritu-amentino", "Espíritu amentino", "Compartimos la identidad simbólica que nos orienta: equilibrio, memoria y fraternidad."],
        ["/insignia", "Insignia", "Mostramos nuestra marca y los criterios con que la usamos en público.", true],
        ["/masoneria", "Masonería", "Respondemos, con cuidado, las preguntas que suelen hacerse sobre nuestra Orden."],
        ["/actualidad", "Actualidad", "Publicamos avisos solo cuando hemos autorizado expresamente hacerlo."],
        ["/contacto", "Contacto", "Abrimos un canal para consultas públicas, con respeto y claridad."]
      ].each do |href, title, copy, with_mark| %>
        <a href="<%= href %>" class="amenti-panel group rounded-2xl p-6 transition hover:border-amber-300/40">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300"><%= title %></h2>
              <p class="mt-3 text-sm text-zinc-400"><%= copy %></p>
            </div>
            <% if with_mark && amenti_mark_path %>
              <%= image_tag amenti_mark_path, alt: "", class: "h-12 w-12 shrink-0 rounded-full object-cover amenti-mark-ring", width: 48, height: 48, loading: "lazy" %>
            <% end %>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>
