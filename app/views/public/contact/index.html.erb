<% content_for :title, "Contacto | Amenti Diez N°31" %>

<section class="mx-auto max-w-5xl px-6 py-14">
  <div class="grid gap-8 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl text-ink sm:text-5xl">Contacto</h1>
      <p class="mt-4 text-zinc-400">
        Abrimos este canal para consultas públicas. Te pedimos no usar este formulario
        para datos sensibles ni para trámites internos de miembros.
      </p>
      <div class="mt-6 space-y-3 rounded-2xl border border-zinc-800 bg-zinc-900/80 p-5 text-sm text-zinc-400">
        <p><span class="font-semibold text-zinc-100">Correo:</span> amentidiez31@granlogiamixta.cl</p>
        <p><span class="font-semibold text-zinc-100">Obediencia:</span> Gran Logia Mixta de Chile</p>
        <p><span class="font-semibold text-zinc-100">Valle:</span> Santiago de Chile</p>
        <p><span class="font-semibold text-zinc-100">Sitio:</span> amenti.cl · logia.amenti.cl</p>
      </div>
    </div>

    <%= form_with model: @contact_message, url: contacto_path, method: :post, class: "rounded-3xl border border-zinc-800 bg-zinc-900/80 p-6 shadow-sm" do |f| %>
      <h2 class="text-lg font-semibold text-zinc-100">Escríbenos</h2>

      <% if @contact_message.errors.any? %>
        <div class="mt-4 rounded-lg border border-amber-800 bg-amber-950/40 px-3 py-2 text-sm text-amber-200">
          <ul class="list-disc pl-4">
            <% @contact_message.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mt-4 space-y-4">
        <%# Honeypot antispam: oculto para humanos %>
        <div class="hidden" aria-hidden="true">
          <label>Sitio web
            <input type="text" name="contact_message[website]" tabindex="-1" autocomplete="off">
          </label>
        </div>

        <%= f.label :name, "Nombre", class: "block text-sm font-medium text-zinc-200" %>
        <%= f.text_field :name, required: true, class: "mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-900/40", placeholder: "Nombre completo" %>

        <%= f.label :email, "Correo", class: "mt-3 block text-sm font-medium text-zinc-200" %>
        <%= f.email_field :email, required: true, class: "mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-900/40", placeholder: "correo@dominio.com" %>

        <%= f.label :phone, "Teléfono (opcional)", class: "mt-3 block text-sm font-medium text-zinc-200" %>
        <%= f.telephone_field :phone, class: "mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-900/40" %>

        <%= f.label :subject, "Motivo", class: "mt-3 block text-sm font-medium text-zinc-200" %>
        <%= f.text_field :subject, class: "mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-900/40", placeholder: "Motivo del mensaje" %>

        <%= f.label :message, "Mensaje", class: "mt-3 block text-sm font-medium text-zinc-200" %>
        <%= f.text_area :message, rows: 4, required: true, class: "mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 focus:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-900/40", placeholder: "Escribe tu mensaje" %>

        <p class="text-xs text-zinc-500">Al enviar aceptas el tratamiento de estos datos solo para responder tu consulta.</p>

        <%= f.submit "Enviar mensaje", class: "w-full cursor-pointer rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700" %>
      </div>
    <% end %>
  </div>
</section>
