<% content_for :title, "Inicio | Amenti Diez N°31" %>

<section class="relative mx-auto max-w-7xl px-6 pb-8 pt-8 sm:pt-12">
  <div class="amenti-panel amenti-panel-gold relative overflow-hidden rounded-[1.75rem]">
    <div class="pointer-events-none absolute inset-0 opacity-[0.18] amenti-mosaic"></div>
    <div class="pointer-events-none absolute -left-16 top-0 h-80 w-80 rounded-full bg-brand/25 blur-3xl"></div>

    <div class="relative grid items-stretch lg:grid-cols-[1.15fr_0.85fr]">
      <div class="amenti-rise flex flex-col justify-center px-8 py-12 sm:px-12 sm:py-16">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-amber-300/90">
          Respetable Logia Simbólica · N°31
        </p>
        <h1 class="font-display mt-5 text-5xl leading-[1.05] text-ink sm:text-6xl lg:text-[4.25rem]">
          Desde 1960,<br class="hidden sm:block"> labramos la piedra que somos.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-zinc-300 sm:text-lg">
          Somos la R∴L∴S∴ Amenti Diez N°31, adscrita a la Gran Logia Mixta de Chile en el Valle de Santiago.
          Aquí cultivamos memoria, fraternidad y trabajo interior, con una presencia pública sobria.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/historia" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-night transition hover:bg-amber-200">Nuestra historia</a>
          <a href="/espiritu-amentino" class="btn-ghost rounded-full px-6 py-3 text-sm font-semibold">Quiénes somos</a>
          <a href="/insignia" class="btn-ghost rounded-full px-6 py-3 text-sm font-semibold">Nuestra insignia</a>
        </div>
      </div>

      <% if amenti_hero_logo_path %>
        <div class="hero-logo-panel amenti-rise amenti-rise-delay-1 relative flex items-center justify-center border-t px-8 py-10 lg:border-l lg:border-t-0 lg:px-10 lg:py-12">
          <%= image_tag amenti_hero_logo_path,
                        alt: "Insignia de la R∴L∴S∴ Amenti Diez N°31",
                        class: "hero-logo-image relative z-10 w-full max-w-[280px] rounded-[1.35rem] sm:max-w-[320px]",
                        width: 320,
                        height: 320,
                        decoding: "async" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-6 pb-10">
  <div class="grid gap-4 md:grid-cols-3">
    <article class="amenti-rise amenti-rise-delay-1 amenti-panel rounded-2xl p-6 transition hover:border-amber-300/30">
      <div class="mb-5 flex items-center gap-3">
        <% if amenti_seal_path %>
          <%= image_tag amenti_seal_path, alt: "", class: "h-12 w-12 rounded-full object-cover amenti-mark-ring", width: 48, height: 48, loading: "lazy" %>
        <% end %>
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">Identidad</h2>
      </div>
      <p class="text-sm leading-relaxed text-zinc-400">
        Nos llamamos Amenti porque evocamos tránsito, equilibrio y memoria. Buscamos una referencia
        elegante y contemporánea: verdad, armonía y cadena de unión, lejos de toda caricatura.
      </p>
    </article>

    <article class="amenti-rise amenti-rise-delay-2 amenti-panel rounded-2xl p-6 transition hover:border-amber-300/30">
      <div class="mb-5 flex items-center gap-3">
        <% if amenti_mark_path %>
          <%= image_tag amenti_mark_path, alt: "", class: "h-12 w-12 rounded-full object-cover amenti-mark-ring", width: 48, height: 48, loading: "lazy" %>
        <% end %>
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">Fundación</h2>
      </div>
      <p class="text-sm leading-relaxed text-zinc-400">
        Levantamos nuestras columnas el 4 de agosto de 1960. Desde 1982 somos la Logia N°31
        de la Gran Logia Mixta de Chile, y conservamos “Diez” en el nombre como memoria de origen.
      </p>
    </article>

    <article class="amenti-rise amenti-rise-delay-3 amenti-panel rounded-2xl p-6 transition hover:border-amber-300/30">
      <div class="mb-5 flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-full border border-amber-300/35 bg-accent/10 font-display text-lg text-amber-200">31</div>
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">Trabajo</h2>
      </div>
      <p class="text-sm leading-relaxed text-zinc-400">
        Ordenamos nuestra formación, secretaría y fraternidad con respeto a lo público,
        a lo interno y a lo confidencial. Cada generación continúa el oficio.
      </p>
    </article>
  </div>
</section>

<section class="mx-auto max-w-7xl px-6 pb-16">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="font-display text-3xl text-ink sm:text-4xl">Ambientes de nuestro trabajo</h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Compartimos imágenes de ambientación autorizadas. No documentamos el interior del templo
        ni sustituimos el patrimonio fotográfico que requiere consentimiento explícito.
      </p>
    </div>
    <a href="/sobre-nosotros" class="text-sm font-semibold text-amber-300 hover:underline">Conócenos →</a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <% [
      ["/images/galeria_templo.webp", "Templo y ceremonia", "Así enmarcamos nuestro trabajo ritual.", "Ambientación visual — templo y ceremonia"],
      ["/images/galeria_biblioteca.webp", "Biblioteca y estudio", "Aquí sostenemos la formación y el estudio permanente.", "Ambientación visual — biblioteca y estudio"],
      ["/images/galeria_comunidad.webp", "Comunidad fraterna", "Cuidamos el vínculo social y el servicio institucional.", "Ambientación visual — comunidad fraterna"]
    ].each_with_index do |(src, title, copy, alt), i| %>
      <article class="amenti-panel group overflow-hidden rounded-2xl">
        <div class="relative h-48 overflow-hidden bg-zinc-950">
          <%= image_tag src,
                        alt: alt,
                        class: "absolute inset-0 h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                        loading: "lazy",
                        decoding: "async" %>
          <div class="gallery-overlay absolute inset-0"></div>
        </div>
        <div class="p-5">
          <h3 class="font-display text-2xl text-ink"><%= title %></h3>
          <p class="mt-1 text-sm text-zinc-400"><%= copy %></p>
        </div>
      </article>
    <% end %>
  </div>
</section>
