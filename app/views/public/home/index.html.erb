<% content_for :title, "Inicio | Amenti Diez N°31" %>

<section class="relative mx-auto max-w-7xl px-6 pb-8 pt-10">
  <div class="relative overflow-hidden rounded-3xl border border-zinc-800 bg-gradient-to-br from-zinc-950 via-slate-950 to-zinc-900 px-8 py-14 shadow-2xl sm:px-12 sm:py-20">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(212,175,55,0.12),_transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(30,58,95,0.35),_transparent_50%)]"></div>
    <div class="relative max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-200/90">
        Respetable Logia Simbolica Amenti Diez N°31
      </p>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl lg:text-6xl">
        Desde 1960, trabajando la piedra que somos.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-zinc-300 sm:text-lg">
        Gran Logia Mixta de Chile · Valle de Santiago.
        Memoria, fraternidad y trabajo interior, proyectados con sobriedad.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/historia" class="rounded-xl bg-amber-200/95 px-5 py-3 text-sm font-semibold text-zinc-950 hover:bg-amber-100">Conoce nuestra historia</a>
        <a href="/espiritu-amentino" class="rounded-xl border border-zinc-600 px-5 py-3 text-sm font-semibold text-zinc-100 hover:border-amber-300 hover:text-amber-200">Qué es Amenti</a>
        <a href="/contacto" class="rounded-xl border border-zinc-600 px-5 py-3 text-sm font-semibold text-zinc-100 hover:border-amber-300 hover:text-amber-200">Contacto</a>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-6 pb-10">
  <div class="grid gap-4 md:grid-cols-3">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-300">Identidad</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-400">
        Amenti evoca tránsito, equilibrio y memoria. La referencia es elegante y contemporánea,
        nunca una caricatura: verdad, armonía y cadena de unión.
      </p>
    </article>
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-300">Fundación</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-400">
        Columnas levantadas el 4 de agosto de 1960. Desde 1982, N°31 en la Gran Logia Mixta de Chile,
        conservando “Diez” como memoria de origen.
      </p>
    </article>
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-300">Trabajo</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-400">
        Formación, secretaría y fraternidad ordenadas con respeto a lo público,
        lo interno y lo confidencial.
      </p>
    </article>
  </div>
</section>

<section class="mx-auto max-w-7xl px-6 pb-14">
  <div class="mb-4">
    <h2 class="text-2xl font-bold text-zinc-100">Galeria institucional</h2>
    <p class="mt-1 text-sm text-zinc-400">
      Ambientacion visual autorizada. No documenta el interior del templo ni sustituye
      el patrimonio fotografico con consentimiento explicito.
    </p>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-4">
      <div class="group relative h-44 overflow-hidden rounded-xl bg-zinc-950">
        <%= image_tag "/images/galeria_templo.webp",
                      alt: "Ambientacion visual — templo y ceremonia",
                      class: "absolute inset-0 h-full w-full object-cover transition-transform duration-300 ease-out will-change-transform group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                      loading: "lazy",
                      decoding: "async" %>
      </div>
      <h3 class="mt-3 font-semibold text-zinc-100">Templo y ceremonia</h3>
      <p class="mt-1 text-sm text-zinc-400">Marco visual para el trabajo ritual.</p>
    </article>
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-4">
      <div class="group relative h-44 overflow-hidden rounded-xl bg-zinc-950">
        <%= image_tag "/images/galeria_biblioteca.webp",
                      alt: "Ambientacion visual — biblioteca y estudio",
                      class: "absolute inset-0 h-full w-full object-cover transition-transform duration-300 ease-out will-change-transform group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                      loading: "lazy",
                      decoding: "async" %>
      </div>
      <h3 class="mt-3 font-semibold text-zinc-100">Biblioteca y estudio</h3>
      <p class="mt-1 text-sm text-zinc-400">Formacion y trabajo intelectual permanente.</p>
    </article>
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-4">
      <div class="group relative h-44 overflow-hidden rounded-xl bg-zinc-950">
        <%= image_tag "/images/galeria_comunidad.webp",
                      alt: "Ambientacion visual — comunidad fraterna",
                      class: "absolute inset-0 h-full w-full object-cover transition-transform duration-300 ease-out will-change-transform group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                      loading: "lazy",
                      decoding: "async" %>
      </div>
      <h3 class="mt-3 font-semibold text-zinc-100">Comunidad fraterna</h3>
      <p class="mt-1 text-sm text-zinc-400">Vinculo social y servicio institucional.</p>
    </article>
  </div>
</section>
