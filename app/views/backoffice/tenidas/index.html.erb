<% content_for :title, "Tenidas | Secretaria" %>
<section class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-100">Tenidas</h1>
      <p class="mt-1 text-sm text-zinc-400">Planificacion y registro de Tenidas. Quien preside es independiente del cargo titular del periodo.</p>
    </div>
    <div class="flex gap-2">
      <a href="/backoffice/secretaria" class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200">Secretaria</a>
      <a href="/backoffice/tenidas/new" class="rounded-lg bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700">Nueva Tenida</a>
    </div>
  </div>

  <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900 p-4">
    <%= form_with url: backoffice_tenidas_path, method: :get, class: "flex flex-wrap gap-3" do %>
      <%= select_tag :status,
            options_for_select([["Todos los estados", ""]] + Tenida.statuses.keys.map { |k| [k.humanize, k] }, @status),
            class: "rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm" %>
      <button type="submit" class="rounded-lg bg-black px-4 py-2 text-sm font-semibold text-white">Filtrar</button>
    <% end %>
  </div>

  <div class="mt-6 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
    <table class="min-w-full divide-y divide-zinc-800 text-sm">
      <thead class="bg-zinc-950 text-left text-xs uppercase tracking-wide text-zinc-500">
        <tr>
          <th class="px-4 py-3">Codigo</th>
          <th class="px-4 py-3">Fecha</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Grado</th>
          <th class="px-4 py-3">Quien preside</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @tenidas.each do |tenida| %>
          <tr class="hover:bg-zinc-950">
            <td class="px-4 py-3 font-medium text-zinc-200"><%= tenida.code %></td>
            <td class="px-4 py-3"><%= tenida.held_on %></td>
            <td class="px-4 py-3"><%= tenida.tenida_type.humanize %></td>
            <td class="px-4 py-3"><%= tenida.degree&.name || "—" %></td>
            <td class="px-4 py-3">
              <% if tenida.presiding_brother %>
                <%= tenida.presiding_brother.full_name %>
                <span class="text-zinc-500">(<%= tenida.presiding_capacity&.humanize || "s/c" %>)</span>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-4 py-3"><%= tenida.status.humanize %></td>
            <td class="px-4 py-3"><a href="<%= backoffice_tenida_path(tenida) %>" class="text-amber-300 hover:underline">Ver</a></td>
          </tr>
        <% end %>
        <% if @tenidas.empty? %>
          <tr><td colspan="7" class="px-4 py-6 text-zinc-500">Sin Tenidas registradas.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
