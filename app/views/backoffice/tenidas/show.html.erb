<% content_for :title, "#{@tenida.code} | Tenida" %>
<section class="mx-auto max-w-5xl px-6 py-10">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs uppercase tracking-wide text-amber-300"><%= @tenida.tenida_type.humanize %></p>
      <h1 class="mt-1 text-3xl font-bold text-zinc-100"><%= @tenida.code %></h1>
      <p class="mt-1 text-sm text-zinc-400"><%= @tenida.held_on %> · <%= @tenida.status.humanize %><% if @tenida.degree %> · <%= @tenida.degree.name %><% end %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @tenida.status_planned? %>
        <%= button_to "Marcar citada", mark_cited_backoffice_tenida_path(@tenida), method: :patch, class: "rounded-lg border border-zinc-700 px-3 py-2 text-xs font-semibold text-zinc-200" %>
      <% end %>
      <% if @tenida.can_mark_held? %>
        <%= button_to "Marcar realizada", mark_held_backoffice_tenida_path(@tenida), method: :patch, class: "rounded-lg border border-zinc-700 px-3 py-2 text-xs font-semibold text-zinc-200" %>
      <% end %>
      <% if @tenida.can_cancel? %>
        <%= button_to "Cancelar", cancel_backoffice_tenida_path(@tenida), method: :patch, class: "rounded-lg border border-rose-900 px-3 py-2 text-xs font-semibold text-rose-300", data: { turbo_confirm: "Cancelar esta Tenida?" } %>
      <% end %>
      <a href="<%= edit_backoffice_tenida_path(@tenida) %>" class="rounded-lg border border-zinc-700 px-3 py-2 text-sm text-zinc-200">Editar</a>
      <a href="/backoffice/tenidas" class="rounded-lg bg-black px-3 py-2 text-sm text-white">Volver</a>
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <article class="rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-300">
      <h2 class="font-semibold text-zinc-100">Quien preside (esta Tenida)</h2>
      <% if @tenida.presiding_brother %>
        <p class="mt-3"><%= @tenida.presiding_brother.full_name %></p>
        <p class="text-zinc-500">Condicion: <%= @tenida.presiding_capacity&.humanize || "no indicada" %></p>
      <% else %>
        <p class="mt-3 text-zinc-500">Sin definir.</p>
      <% end %>
      <% if @tenida.place.present? %><p class="mt-3">Lugar: <%= @tenida.place %></p><% end %>
      <% if @tenida.notes.present? %><p class="mt-3 whitespace-pre-wrap"><%= @tenida.notes %></p><% end %>
    </article>

    <article class="rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-300">
      <h2 class="font-semibold text-zinc-100">Cargos titulares vigentes (periodo)</h2>
      <p class="mt-1 text-xs text-zinc-500">Referencia del cuadro logial a la fecha de la Tenida — distinto de quien preside.</p>
      <ul class="mt-3 space-y-2">
        <% @titular_offices.each do |assignment| %>
          <li class="rounded-lg border border-zinc-800 px-3 py-2">
            <span class="text-zinc-100"><%= assignment.office.name %></span>
            — <%= assignment.brother.full_name %>
          </li>
        <% end %>
        <% if @titular_offices.empty? %>
          <li class="text-zinc-500">Sin cargos vigentes registrados para esa fecha.</li>
        <% end %>
      </ul>
    </article>
  </div>

  <article class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900 p-5">
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-semibold text-zinc-100">Actas vinculadas</h2>
      <a href="/backoffice/minutes/new?tenida_id=<%= @tenida.id %>" class="text-sm text-amber-300 hover:underline">Nueva acta para esta Tenida</a>
    </div>
    <div class="mt-3 space-y-2 text-sm">
      <% @minutes.each do |minute| %>
        <a href="<%= backoffice_minute_path(minute) %>" class="block rounded-lg border border-zinc-800 p-3 hover:bg-zinc-800/50">
          <p class="font-medium text-zinc-200"><%= minute.folio %> — <%= minute.title %></p>
          <p class="text-zinc-500"><%= minute.status.humanize %></p>
        </a>
      <% end %>
      <% if @minutes.empty? %>
        <p class="text-zinc-500">Aun no hay actas asociadas.</p>
      <% end %>
    </div>
  </article>
</section>
