<% content_for :title, "Usuarios | Administracion" %>
<section class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-bold text-zinc-100">Usuarios del sistema</h1>
      <p class="mt-1 text-sm text-zinc-400">Alta, edicion, roles y estado de acceso al backoffice.</p>
    </div>
    <div class="flex gap-2">
      <a href="<%= new_backoffice_admin_user_path %>" class="rounded-lg bg-black px-4 py-2 text-sm font-semibold text-white">Nuevo usuario</a>
      <a href="<%= backoffice_administration_path %>" class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200">Volver</a>
    </div>
  </div>

  <div class="mt-8 overflow-x-auto rounded-2xl border border-zinc-800 bg-zinc-900">
    <table class="min-w-full divide-y divide-zinc-800 text-sm">
      <thead class="text-left text-xs uppercase tracking-wide text-zinc-500">
        <tr>
          <th class="px-5 py-4">Usuario</th>
          <th class="px-5 py-4">Estado</th>
          <th class="px-5 py-4">Roles</th>
          <th class="px-5 py-4">Ultimo acceso</th>
          <th class="px-5 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @users.each do |user| %>
          <tr>
            <td class="px-5 py-4">
              <p class="font-medium text-zinc-100"><%= user.full_name %></p>
              <p class="text-xs text-zinc-500"><%= user.email %></p>
            </td>
            <td class="px-5 py-4">
              <% if !user.active? %>
                <span class="rounded-full bg-zinc-800 px-2 py-1 text-xs text-zinc-400">Inactivo</span>
              <% elsif user.locked? %>
                <span class="rounded-full bg-rose-950/40 px-2 py-1 text-xs text-rose-300">Bloqueado</span>
              <% else %>
                <span class="rounded-full bg-emerald-950/40 px-2 py-1 text-xs text-emerald-300">Activo</span>
              <% end %>
            </td>
            <td class="px-5 py-4 text-xs text-zinc-400"><%= user.roles.order(:key).pluck(:key).join(", ").presence || "-" %></td>
            <td class="px-5 py-4 text-zinc-400"><%= user.last_sign_in_at&.strftime("%d/%m/%Y %H:%M") || "-" %></td>
            <td class="px-5 py-4">
              <div class="flex flex-wrap gap-2">
                <a href="<%= edit_backoffice_admin_user_path(user) %>" class="text-amber-300 hover:underline">Editar</a>
                <% if user.locked? || !user.active? %>
                  <%= button_to "Desbloquear", unlock_backoffice_admin_user_path(user), method: :patch, class: "text-emerald-400 hover:underline" %>
                <% end %>
                <% if user.id != current_user.id && user.active? %>
                  <%= button_to "Desactivar", backoffice_admin_user_path(user), method: :delete, form: { data: { turbo_confirm: "¿Desactivar acceso de #{user.email}?" } }, class: "text-rose-400 hover:underline" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
