<% content_for :title, "Editar usuario | Administracion" %>
<section class="mx-auto max-w-4xl px-6 py-10">
  <h1 class="text-3xl font-bold text-zinc-100">Editar usuario</h1>
  <p class="mt-1 text-sm text-zinc-400"><%= @user.email %></p>

  <div class="mt-8">
    <%= render "form", submit_label: "Guardar cambios" %>
  </div>

  <% unless @user.new_record? %>
    <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Asignacion rapida por plantilla</p>
      <%= form_with url: apply_role_template_backoffice_admin_user_path(@user), method: :patch, class: "mt-3 flex flex-wrap items-center gap-2" do %>
        <%= select_tag :template_key, options_for_select(@role_templates.map { |key, cfg| [cfg[:name], key] }), class: "rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200" %>
        <button type="submit" class="rounded-lg border border-zinc-700 px-3 py-2 text-sm font-semibold text-zinc-200 hover:border-amber-300">Aplicar plantilla</button>
      <% end %>
    </div>
  <% end %>
</section>
