<% content_for :title, "Google Workspace | Secretaria" %>

<section class="mx-auto max-w-4xl px-6 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-100">Google Workspace</h1>
      <p class="mt-1 text-sm text-zinc-400">
        Buzon institucional <%= Workspace::Config.institutional_email %> — OAuth de usuario (sin admin de dominio).
      </p>
    </div>
    <a href="/backoffice/secretaria" class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200">Secretaria</a>
  </div>

  <% unless @configured %>
    <div class="mt-6 rounded-xl border border-amber-900/60 bg-amber-950/30 px-4 py-3 text-sm text-amber-200">
      Defina <code class="text-amber-100">GOOGLE_CLIENT_ID</code>, <code class="text-amber-100">GOOGLE_CLIENT_SECRET</code>
      y opcionalmente <code class="text-amber-100">GOOGLE_OAUTH_REDIRECT_URI</code> en el entorno.
      Redirect tipico: <code class="text-xs">http://localhost:3000/backoffice/workspace/callback</code>
    </div>
  <% end %>

  <article class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900 p-6 text-sm text-zinc-300">
    <h2 class="text-lg font-semibold text-zinc-100">Estado de conexion</h2>
    <dl class="mt-4 grid gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-wide text-zinc-500">Estado</dt>
        <dd class="mt-1 font-medium text-zinc-100"><%= @connection.status %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-zinc-500">Cuenta</dt>
        <dd class="mt-1"><%= @connection.account_email.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-zinc-500">Ultima sync</dt>
        <dd class="mt-1"><%= @connection.last_synced_at&.strftime("%d/%m/%Y %H:%M") || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-zinc-500">Expira access token</dt>
        <dd class="mt-1"><%= @connection.expires_at&.strftime("%d/%m/%Y %H:%M") || "—" %></dd>
      </div>
    </dl>
    <% if @connection.last_error.present? %>
      <p class="mt-4 rounded-lg border border-rose-900/50 bg-rose-950/30 px-3 py-2 text-rose-200"><%= @connection.last_error %></p>
    <% end %>

    <div class="mt-6 flex flex-wrap gap-2">
      <% if @configured && !@connection.connected? %>
        <%= button_to(@connection.status == "error" ? "Reconectar Google Workspace" : "Conectar Google Workspace", connect_backoffice_workspace_path, method: :post, class: "rounded-lg bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700") %>
      <% end %>
      <% if @connection.connected? %>
        <%= button_to "Comprobar conexion", health_backoffice_workspace_path, method: :post, class: "rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200" %>
        <%= button_to "Importar Gmail", import_gmail_backoffice_workspace_path, method: :post, class: "rounded-lg bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700" %>
        <%= button_to "Desconectar", disconnect_backoffice_workspace_path, method: :delete, class: "rounded-lg border border-rose-900 px-4 py-2 text-sm font-semibold text-rose-300", data: { turbo_confirm: "Desvincular Google Workspace?" } %>
      <% elsif @connection.status == "error" %>
        <p class="text-xs text-zinc-500">Tras un error de OAuth use Reconectar (consentimiento de Google de nuevo).</p>
      <% end %>
    </div>
  </article>

  <article class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900 p-6">
    <h2 class="text-lg font-semibold text-zinc-100">Enlaces Gmail recientes</h2>
    <div class="mt-3 space-y-2 text-sm">
      <% @recent_gmail_links.each do |link| %>
        <div class="flex items-center justify-between rounded-lg border border-zinc-800 px-3 py-2">
          <div>
            <p class="text-zinc-200"><%= link.linkable_type %> #<%= link.linkable_id %></p>
            <p class="text-xs text-zinc-500"><%= link.external_id %></p>
          </div>
          <% if link.external_url.present? %>
            <a href="<%= link.external_url %>" target="_blank" rel="noopener" class="text-amber-300 hover:underline">Abrir en Gmail</a>
          <% end %>
        </div>
      <% end %>
      <% if @recent_gmail_links.empty? %>
        <p class="text-zinc-500">Sin importaciones aun.</p>
      <% end %>
    </div>
  </article>

  <p class="mt-6 text-xs text-zinc-500">
    Scopes: gmail.readonly, calendar.events, drive.file. Rails guarda metadatos e IDs; no espeja el buzon completo.
    Ver <code>docs/workspace-runbook.md</code>.
  </p>
</section>
