<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Amenti Diez N°31" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Amenti Diez N°31">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#070b12" id="theme-color-meta">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              ink: "#f4f1ea",
              brand: "#1e4d8c",
              accent: "#d4af37",
              night: "#070b12",
              panel: "#0e1522"
            },
            fontFamily: {
              display: ['"Cormorant Garamond"', "serif"],
              sans: ['"Outfit"', "ui-sans-serif", "system-ui", "sans-serif"]
            }
          }
        }
      }
    </script>
    <style>
      body { font-family: "Outfit", ui-sans-serif, system-ui, sans-serif; }
      h1, h2, .font-display { font-family: "Cormorant Garamond", serif; }

      button, a { text-underline-offset: 3px; }

      html:not(.theme-light) input,
      html:not(.theme-light) select,
      html:not(.theme-light) textarea {
        background-color: #121826 !important;
        color: #f4f1ea !important;
        border-color: #2a3344 !important;
      }
      html:not(.theme-light) input::placeholder,
      html:not(.theme-light) textarea::placeholder { color: #8b93a7 !important; }

      .theme-light input,
      .theme-light select,
      .theme-light textarea {
        background-color: #ffffff !important;
        color: #121826 !important;
        border-color: #d5cfc2 !important;
      }
      .theme-light input::placeholder,
      .theme-light textarea::placeholder { color: #64748b !important; }
    </style>
    <script>
      (function() {
        function applyTheme(theme) {
          document.documentElement.classList.toggle("theme-light", theme === "light");
          localStorage.setItem("theme", theme);
          var labelText = theme === "light" ? "Claro" : "Oscuro";
          ["theme-toggle-label", "mobile-theme-toggle-label"].forEach(function(id) {
            var label = document.getElementById(id);
            if (label) label.textContent = labelText;
          });
          var meta = document.getElementById("theme-color-meta");
          if (meta) meta.content = theme === "light" ? "#f7f4ee" : "#070b12";
          document.querySelectorAll("[data-logo-dark],[data-logo-light]").forEach(function(img) {
            var dark = img.getAttribute("data-logo-dark");
            var light = img.getAttribute("data-logo-light");
            if (!dark || !light) return;
            img.src = theme === "light" ? light : dark;
          });
        }

        function toggleTheme() {
          var isLight = document.documentElement.classList.contains("theme-light");
          applyTheme(isLight ? "dark" : "light");
        }

        function setMobileNav(open) {
          var panel = document.getElementById("mobile-nav-panel");
          var toggle = document.getElementById("mobile-nav-toggle");
          if (!panel || !toggle) return;
          panel.hidden = !open;
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
          document.body.classList.toggle("mobile-nav-open", open);
          toggle.querySelector(".mobile-nav-toggle-open").classList.toggle("hidden", open);
          toggle.querySelector(".mobile-nav-toggle-close").classList.toggle("hidden", !open);
        }

        var saved = localStorage.getItem("theme");
        applyTheme(saved || "dark");

        document.addEventListener("DOMContentLoaded", function() {
          var themeButton = document.getElementById("theme-toggle");
          if (themeButton) themeButton.addEventListener("click", toggleTheme);

          var mobileThemeButton = document.getElementById("mobile-theme-toggle");
          if (mobileThemeButton) mobileThemeButton.addEventListener("click", toggleTheme);

          var mobileToggle = document.getElementById("mobile-nav-toggle");
          var mobilePanel = document.getElementById("mobile-nav-panel");
          if (mobileToggle && mobilePanel) {
            mobileToggle.addEventListener("click", function() {
              setMobileNav(mobilePanel.hidden);
            });
            mobilePanel.querySelectorAll("a").forEach(function(link) {
              link.addEventListener("click", function() { setMobileNav(false); });
            });
            document.addEventListener("keydown", function(event) {
              if (event.key === "Escape") setMobileNav(false);
            });
            window.addEventListener("resize", function() {
              if (window.innerWidth >= 1024) setMobileNav(false);
            });
          }
        });
      })();
    </script>
  </head>

  <body class="amenti-shell min-h-screen text-ink antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 amenti-grid-fade opacity-60"></div>

    <% nav_links = [
      ["/", "Inicio"],
      ["/sobre-nosotros", "Amenti"],
      ["/historia", "Historia"],
      ["/masoneria", "Masonería"],
      ["/actualidad", "Actualidad"],
      ["/contacto", "Contacto"]
    ] %>

    <header class="site-header sticky top-0 z-40">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6">
        <a href="/" class="site-brand group flex min-w-0 flex-1 items-center gap-2.5 sm:gap-3.5 lg:flex-none">
          <% if amenti_mark_path %>
            <span class="site-brand-mark h-10 w-10 sm:h-11 sm:w-11">
              <%= image_tag amenti_mark_path,
                            alt: "",
                            class: "h-full w-full object-contain p-1.5",
                            width: 44,
                            height: 44 %>
            </span>
          <% end %>
          <span class="min-w-0 leading-tight">
            <span class="font-display block truncate text-lg text-ink sm:text-xl lg:text-[1.35rem]">Amenti Diez N°31</span>
            <span class="site-brand-sub block truncate text-[10px] font-medium uppercase tracking-[0.18em] text-zinc-500 sm:tracking-[0.22em]">R∴L∴S∴ · Gran Logia Mixta</span>
          </span>
        </a>

        <nav class="hidden items-center gap-0.5 text-[13px] font-medium lg:flex" aria-label="Principal">
          <% nav_links.each do |href, label| %>
            <a href="<%= href %>" class="site-nav-link px-3 py-2"><%= label %></a>
          <% end %>
        </nav>

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
          <button id="theme-toggle" type="button" class="btn-icon hidden sm:inline-flex" title="Cambiar tema" aria-label="Cambiar tema">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-zinc-400">Tema</span>
            <span id="theme-toggle-label" class="text-[11px] font-semibold text-amber-300/90">Oscuro</span>
          </button>
          <% if user_signed_in? %>
            <a href="/backoffice/perfil" class="btn-outline hidden rounded-lg px-3 py-2 text-xs font-semibold md:inline-flex">Perfil</a>
            <a href="/backoffice" class="btn-primary rounded-lg px-3 py-2 text-xs font-semibold sm:px-4 sm:text-sm">Backoffice</a>
            <%= button_to "Salir", "/cerrar-sesion", method: :delete, class: "btn-outline hidden rounded-lg px-3 py-2 text-xs font-semibold lg:inline-flex" %>
          <% else %>
            <a href="/backoffice" class="btn-primary rounded-lg px-3 py-2 text-xs font-semibold sm:px-4 sm:text-sm">Backoffice</a>
          <% end %>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="mobile-nav-toggle btn-icon inline-flex lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="Abrir menú de navegación">
            <svg class="mobile-nav-toggle-open h-5 w-5 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
            <svg class="mobile-nav-toggle-close hidden h-5 w-5 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-panel" class="mobile-nav-panel lg:hidden" hidden>
        <nav class="mx-auto max-w-7xl px-4 pb-4 sm:px-6" aria-label="Principal móvil">
          <% nav_links.each do |href, label| %>
            <a href="<%= href %>" class="mobile-nav-link"><%= label %></a>
          <% end %>
          <button id="mobile-theme-toggle" type="button" class="mobile-nav-theme btn-icon mt-3 w-full justify-center sm:hidden">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-zinc-400">Tema</span>
            <span id="mobile-theme-toggle-label" class="text-[11px] font-semibold text-amber-300/90">Oscuro</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <% if flash[:notice] %>
        <div class="mx-auto mt-4 max-w-7xl rounded-xl border border-emerald-800/60 bg-emerald-950/50 px-4 py-3 text-sm text-emerald-300">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mx-auto mt-4 max-w-7xl rounded-xl border border-amber-800/60 bg-amber-950/50 px-4 py-3 text-sm text-amber-300">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer mt-20">
      <div class="site-footer-accent" aria-hidden="true"></div>
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 md:grid-cols-[1.15fr_0.85fr_1fr] md:items-start">
          <div class="site-footer-brand flex items-start gap-4">
            <% if amenti_seal_path %>
              <span class="site-brand-mark h-16 w-16 shrink-0">
                <%= image_tag amenti_seal_path,
                              alt: "",
                              class: "h-full w-full object-contain p-2",
                              width: 64,
                              height: 64,
                              loading: "lazy",
                              decoding: "async" %>
              </span>
            <% end %>
            <div>
              <p class="font-display text-2xl text-ink sm:text-[1.65rem]">Amenti Diez N°31</p>
              <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">R∴L∴S∴ G∴L∴M∴Ch∴</p>
              <p class="mt-3 max-w-sm text-xs leading-relaxed text-zinc-500">
                Presencia pública sobria de nuestra Logia. Lo ritual, lo interno y lo confidencial
                se cuidan con el mismo rigor institucional.
              </p>
            </div>
          </div>

          <div>
            <p class="site-footer-heading">Explorar</p>
            <nav class="mt-4 flex flex-col gap-2.5" aria-label="Pie de página">
              <% [
                ["/sobre-nosotros", "Quiénes somos"],
                ["/historia", "Historia"],
                ["/insignia", "Insignia"],
                ["/contacto", "Contacto"]
              ].each do |href, label| %>
                <a href="<%= href %>" class="site-footer-link text-sm"><%= label %></a>
              <% end %>
            </nav>
          </div>

          <div>
            <p class="site-footer-heading">Acceso</p>
            <nav class="mt-4 flex flex-col gap-2.5" aria-label="Acceso">
              <% [
                ["/iniciar-sesion", "Acceso miembros"],
                ["/backoffice", "Backoffice"],
                ["/sobre-el-sistema", "Sobre el sistema"]
              ].each do |href, label| %>
                <a href="<%= href %>" class="site-footer-link text-sm"><%= label %></a>
              <% end %>
            </nav>
          </div>
        </div>

        <div class="site-footer-bottom mt-10 flex flex-col gap-3 border-t border-white/5 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-zinc-500">© <%= Date.current.year %> Amenti Diez N°31 · Uso institucional</p>
          <p class="text-xs text-zinc-500">logia.amenti.cl · amenti.cl</p>
        </div>
      </div>
    </footer>
  </body>
</html>
